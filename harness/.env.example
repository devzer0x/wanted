# WANTED harness settings. Copy to .env and fill in real values on the game server.
# The harness fails loudly when a required value is absent — it never pretends a
# dependency is up.

# --- Claude API (brain) -------------------------------------------------------
# Required for tactical/director decisions. Without it the brain refuses to start
# and `python -m wasted_harness.main --check` reports it as missing.
ANTHROPIC_API_KEY=

# --- Bridge (game) ------------------------------------------------------------
WASTED_BRIDGE_URL=http://127.0.0.1:7777

# --- Supabase (events/decisions/stats/clips writes; service-role key) ---------
# Server-side only. Never ship this key to a browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- OBS websocket (clips via replay buffer) ----------------------------------
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# --- Overlay (OBS browser source) ---------------------------------------------
WASTED_OVERLAY_HOST=127.0.0.1
WASTED_OVERLAY_PORT=7788

# --- Budget governor (CONTRACTS §7) -------------------------------------------
# Hourly spend cap in USD; L1/L2/L3 engage at rising fractions of this cap.
WASTED_HOURLY_CAP_USD=1.50

# --- Runtime state ------------------------------------------------------------
# Rolling summary, journal, day log, offline event queue, commentary rotation.
# Defaults to <repo>/harness/state.
#WASTED_STATE_DIR=
# Pricing file override (defaults to <repo>/harness/config/pricing.yaml).
#WASTED_PRICING_FILE=
# Perception poll rate in Hz (clamped to 2-4).
#WASTED_POLL_HZ=3.0
# Set false to keep the agent in free roam: no mission starts, story calls ring out.
WASTED_MISSIONS_ENABLED=true
