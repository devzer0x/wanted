<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WastedBridge</AssemblyName>
    <RootNamespace>WastedBridge</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- SHVDN loads scripts into the game's .NET Framework runtime; no self-contained publish. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ holds the off-server check harness (net8.0) and its SHVDN stubs; the SDK's default
         **/*.cs glob would otherwise pull them into the shipped net48 script. -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned SHVDN nightly v3.7.0-nightly.189 (assembly 3.7.0.189); provided by the game install,
         never copied to output. -->
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
