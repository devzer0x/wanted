# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Playwright build outputs: the live suite and the offline suite each bake their own
# NEXT_PUBLIC_* values, so neither may share `.next` (see playwright.config.ts).
/.next-e2e/
/.next-offline/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is the committed template)
.env*
!.env.example

# playwright
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# transient output of scripts/verify-siwe.mjs
.siwe-verify-*

# local full-loop verification build
.next-loop/
