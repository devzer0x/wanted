# WASTED web — environment template. Copy to .env.local and fill in real values.
# Browser-safe values only; the service-role/secret key must NEVER appear here.

# Supabase project URL + browser key. Both the current publishable-key name and the legacy
# anon-key name are accepted; if both are set, the publishable name wins.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_JWT

# Canonical site origin, used for metadataBase and absolute OG/share URLs. Leave unset on Vercel
# and the app falls back to the VERCEL_PROJECT_PRODUCTION_URL system env var; set it explicitly
# once a custom domain exists.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example

# Stream source fallback (server-only), used when the site_config "stream" row is absent.
# provider: twitch | youtube. For twitch, channel is the Twitch channel name.
STREAM_PROVIDER=twitch
STREAM_CHANNEL=YOUR_CHANNEL

# =============================================================================
# WANTED prediction layer — docs/CONTRACTS-PREDICTIONS.md
# Public values below are public infrastructure constants (chain ids, public
# RPCs, published token addresses), not credentials. Every SECRET is left empty
# on purpose: filling one in here would commit it.
# =============================================================================

# --- Robinhood Chain (verified 2026-09-08 by eth_chainId against both RPCs) ---
# Mainnet 4663 / testnet 46630. Gas is ETH; there is no native chain token.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Tokens ---
# TTWO stock token, verified on-chain: symbol TTWO, 18 decimals.
# Source: https://api.robinhood.com/rhj/assets (public), re-read via eth_call.
NEXT_PUBLIC_TTWO_TOKEN=0x5e81213613b6B86EaB4c6c50d718d34359459786
NEXT_PUBLIC_TTWO_DECIMALS=18
# $WANTED is NOT DEPLOYED YET. Leave empty. Every surface that depends on it
# hides itself while this is blank — it must never render a zero balance,
# because a zero is a claim about reality and we do not have one to make.
NEXT_PUBLIC_WANTED_TOKEN=

# --- Treasury (public address is safe to publish; the KEY is not) ---
# The treasury's public address. Pushed together with the key by web/scripts/treasury-push-key.mjs
# (docs/RUNBOOK.md §5.1). /rules shows it so anyone can audit payouts on the explorer, and the payout
# worker refuses to run if it does not equal the key's own address.
NEXT_PUBLIC_TREASURY_ADDRESS=
# SERVER ONLY and PRODUCTION ONLY — never Preview, never Development, never a value in any file.
# Generated by the operator with `cast wallet new` and pushed from the encrypted keystore by
# web/scripts/treasury-push-key.mjs; never typed, pasted or printed (CONTRACTS-PREDICTIONS §10.7).
# Read only by web/src/lib/rewards/treasury.ts (`import "server-only"`), imported only by the payout worker.
TREASURY_PRIVATE_KEY=
# SERVER ONLY, optional. A private RPC for the treasury's reads and broadcasts; unset = the chain's
# public RPC. Never NEXT_PUBLIC_: a provider URL often embeds an API key.
TREASURY_RPC_URL=

# --- Session signing (server only; the app must refuse to boot without it) ---
SESSION_SECRET=

# --- Cron authorisation for /api/cron/tick (locks + settles due predictions) ---
CRON_SECRET=

# --- Treasury safety rails (CONTRACTS-PREDICTIONS §6, §10.6) ---
# Claim-side switch: anything but true refuses every claim (assessEligibility). Crediting and signing
# have their own instant switches in site_config, below.
REWARDS_ENABLED=
# Claim-side limits. REQUIRED, in BASE units (18 decimals for TTWO); unset refuses every claim.
# Decided values: CLAIM_MIN_AMOUNT 2000000000000000 (0.002 TTWO, so gas is at most ~5% of a payout)
# and CLAIM_MAX_AMOUNT 500000000000000000 (0.5 TTWO per claim; must stay >= max_per_prediction).
# Both are baked into a deployment: setting them does nothing until the next deploy.
CLAIM_MIN_AMOUNT=
CLAIM_MAX_AMOUNT=
#
# Everything else lives in `public.site_config`, because the code that obeys it is Postgres and
# cannot read this environment. All of it takes effect on the next settlement / tick, no deploy:
#
#   -- settlement caps, WHOLE token units; absent, misspelled or non-numeric = no credits at all
#   insert into public.site_config (key, value) values
#     ('reward_caps', '{"daily_cap": 0.25, "max_per_prediction": 0.02, "max_per_wallet_day": 0.05}')
#   on conflict (key) do update set value = excluded.value;
#
#   -- the two switches: enabled = new credits, payouts = signing and broadcasting. Absent = off.
#   insert into public.site_config (key, value) values ('rewards', '{"enabled": false, "payouts": false}')
#   on conflict (key) do update set value = excluded.value;

# --- Eligibility policy (CONTRACTS-PREDICTIONS §5) ---
# TTWO stock tokens are restricted or prohibited in these jurisdictions.
# Server-side only: the UI may reflect ineligibility, never decide it.
POLICY_BLOCKED_REGIONS=US,CA,GB,CH
POLICY_REQUIRE_TERMS=true

# --- Supabase, server side (SERVER ONLY — settlement, entries and reward writes) ---
# The API routes use these, NOT the NEXT_PUBLIC_ pair above: those are the browser's read-only
# credentials. Both are required for any route that touches the prediction schema.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Optional ---
# Wallet session lifetime in seconds; defaults to a sane value if unset.
SESSION_TTL_SECONDS=
# Display symbol for the reward asset; defaults to TTWO.
NEXT_PUBLIC_TTWO_SYMBOL=

# --- SIWE origin safety -------------------------------------------------------
# The SIWE message is signed against this deployment's OWN origin, resolved from
# NEXT_PUBLIC_SITE_URL (else Vercel's VERCEL_PROJECT_PRODUCTION_URL). A production
# build refuses to sign a loopback domain, because the domain in that message is
# what the user reads in their wallet before approving — signing "localhost:3000"
# while they are on the real site is the exact mismatch the pinned domain exists
# to prevent. Set this ONLY to run a production build locally for verification.
ALLOW_LOOPBACK_SIWE=
