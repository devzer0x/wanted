# WASTED web — environment template. Copy to .env.local and fill in real values.
# Browser-safe values only; the service-role/secret key must NEVER appear here.

# Supabase project URL + browser key. Both the current publishable-key name and the legacy
# anon-key name are accepted; if both are set, the publishable name wins.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_JWT

# Canonical site origin, used for metadataBase and absolute OG/share URLs. Leave unset on Vercel
# and the app falls back to the VERCEL_PROJECT_PRODUCTION_URL system env var; set it explicitly
# once a custom domain exists.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example

# Stream source fallback (server-only), used when the site_config "stream" row is absent.
# provider: twitch | youtube. For twitch, channel is the Twitch channel name.
STREAM_PROVIDER=twitch
STREAM_CHANNEL=YOUR_CHANNEL
